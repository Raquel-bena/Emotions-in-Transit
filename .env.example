# ==========================================
# EMOTIONS IN TRANSIT - Environment Variables
# ==========================================
# Copia este archivo a .env y rellena con tus credenciales

# ==========================================
# TMB API (Transports Metropolitans de Barcelona)
# ==========================================
# Obtén tus credenciales en: https://developer.tmb.cat/
TMB_APP_ID=tu_app_id_aqui
TMB_APP_KEY=tu_clave_tmb_aqui

# ==========================================
# OpenWeatherMap API
# ==========================================
# Obtén tu API key en: https://openweathermap.org/api
# Plan gratuito: 60 requests/min, 1M calls/mes
OWM_API_KEY=tu_clave_openweather_aqui

# ==========================================
# Servidor Node.js
# ==========================================
# Puerto para el servidor Express (default: 3000)
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# ==========================================
# Flask API (Emotion Detection)
# ==========================================
# URL de la API Flask con K-Means clustering
# Por defecto apunta al servidor de producción en Render
FLASK_API_URL=https://emotions-in-transit-m2ts.onrender.com/api/emotions

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. NUNCA subas el archivo .env a Git (ya está en .gitignore)
# 2. Sin API keys, el proyecto funcionará en "Ghost Mode" (datos simulados)
# 3. Las claves gratuitas de TMB y OpenWeatherMap tienen límites de uso
# 4. Para producción (Render, Heroku), configura estas variables en el dashboard
